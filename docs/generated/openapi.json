    "/api/v1/links/{code}/stats": {
      "get": {
        "tags": [
          "analytics"
        ],
        "summary": "Link Stats",
        "description": "Click analytics. Requires the link's X-Stats-Token, or the admin X-API-Key.\n\nWithout valid credentials the answer is always 401, even for codes that do not exist, so\nthe endpoint cannot be used to discover which codes are in use.",
        "operationId": "link_stats_api_v1_links__code__stats_get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          },
          {
            "name": "x-stats-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Stats-Token"
