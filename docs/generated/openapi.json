  "components": {
    "schemas": {
      "CreateLinkRequest": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "examples": [
              "https://example.com/some/long/path?x=1"
            ]
          },
          "custom_alias": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32,
                "minLength": 3
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Alias",
            "examples": [
              "spring-sale"
            ]
          },
          "ttl_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Ttl Seconds",
            "examples": [
              86400
            ]
          },
          "max_clicks": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Clicks",
            "examples": [
              100
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "url"
        ],
        "title": "CreateLinkRequest"
      },
      "CreateLinkResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "short_url": {
            "type": "string",
            "title": "Short Url"
          },
          "target_url": {
            "type": "string",
            "title": "Target Url"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "click_count": {
            "type": "integer",
            "title": "Click Count"
          },
          "max_clicks": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Clicks"
          },
          "stats_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stats Token",
            "description": "Secret for GET /api/v1/links/{code}/stats. Returned once, only when the link is created; null when an existing link is reused. Store it; it cannot be recovered."
          }
        },
        "type": "object",
        "required": [
          "code",
          "short_url",
          "target_url",
          "created_at",
          "expires_at",
          "is_active",
          "click_count"
        ],
        "title": "CreateLinkResponse"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
